# 智慧校园图书借阅信息管理系统 V2.0 —— 环境变量配置示例
# 复制本文件为 .env 并填入实际值

# 数据库（必填）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=smart_library_v2

# Redis（可选）
REDIS_URL=redis://localhost:6379/0

# 安全密钥（生产环境务必修改）
SECRET_KEY=your-secret-key-here
AES_KEY=your-32-byte-aes-key-1234

# SMTP 邮件（可选）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 微信模板消息（可选）
WECHAT_ACCESS_TOKEN=
WECHAT_TEMPLATE_ID=

# LLM / AI 问答（可选）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
